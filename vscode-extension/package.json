{
  "name": "dynamic-ss13-modules",
  "displayName": "Dynamic SS13 Modules",
  "description": "Maintainer tools for Dynamic SS13 Modules.",
  "version": "0.1.0",
  "publisher": "dynamic-ss13-modules",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onView:dynamicSs13Modules.modules",
    "onCommand:dynamicSs13Modules.refresh",
    "onCommand:dynamicSs13Modules.explainCurrentFile",
    "onCommand:dynamicSs13Modules.openIndex",
    "onCommand:dynamicSs13Modules.openMaterializedFile"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dynamicSs13Modules.refresh",
        "title": "Dynamic Modules: Refresh"
      },
      {
        "command": "dynamicSs13Modules.explainCurrentFile",
        "title": "Dynamic Modules: Explain Current File"
      },
      {
        "command": "dynamicSs13Modules.openIndex",
        "title": "Dynamic Modules: Open Generated Index"
      },
      {
        "command": "dynamicSs13Modules.openMaterializedFile",
        "title": "Dynamic Modules: Open Materialized File"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dynamicSs13Modules",
          "title": "Dynamic Modules",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "dynamicSs13Modules": [
        {
          "id": "dynamicSs13Modules.modules",
          "name": "Modules"
        }
      ]
    },
    "configuration": {
      "title": "Dynamic SS13 Modules",
      "properties": {
        "dynamicSs13Modules.indexPath": {
          "type": "string",
          "default": ".dynamic_modules_build/index.json",
          "description": "Path to generated Dynamic Modules index, relative to the workspace root."
        }
      }
    }
  }
}
